# ATTENTION : toute variable NON VIDE ici « verrouille » le réglage — le champ
# correspondant apparaît grisé dans l'interface, avec le nom de la variable.
# Laisse commenté ce que tu veux pouvoir régler graphiquement (recommandé).

# --- Général -----------------------------------------------------------
TZ=Europe/Paris
LOCALE=fr-FR
COUNTRY=FR
PROVIDERS=epic,steam,gog,prime
LOG_LEVEL=info

# Planification (cron 5 champs) : 12h05 et 20h05
#CRON_SCHEDULE=5 12,20 * * *
RUN_ON_START=false

# Ne rien réclamer, juste simuler (utile pour tester)
#DRY_RUN=false

# --- Navigateur --------------------------------------------------------
# chromium = par défaut (amd64 + arm64). chrome = amd64 seulement, nécessite
# une image construite avec --build-arg INSTALL_CHROME=true. firefox = échappatoire.
BROWSER=chromium
HEADLESS=true
NAV_TIMEOUT=45000

# --- Interface web -----------------------------------------------------
WEB_ENABLED=true
WEB_PORT=8080
# Auth basique : protège l'interface ET le VNC (WebSocket compris).
# Laisser vide = aucune protection. À remplir dès que l'app est joignable
# par autre chose que toi. Les liens de déblocage reçus en notification
# restent ouvrables sans mot de passe : leur jeton fait office de secret.
WEB_USER=
WEB_PASSWORD=

# --- VNC (connexions manuelles) ---------------------------------------
NOVNC_PORT=6080
VNC_PORT=5900
# Extinction auto du VNC après X secondes d'inactivité
VNC_IDLE_TIMEOUT=1800

# --- Options par store -------------------------------------------------
# Prime Gaming : réclamer aussi le loot in-game (beaucoup de bruit)
#PRIME_CLAIM_LOOT=false
# Steam : packages supplémentaires à activer (ids de sub, séparés par virgule)
STEAM_EXTRA_SUBIDS=

# --- Notifications (tout est optionnel) -------------------------------
# Rappel : ces valeurs se règlent aussi dans l'interface. Les laisser commentées
# ici permet de les modifier graphiquement ; les renseigner les verrouille.
#
# Catégories notifiées : claim, failure, captcha, available
#NOTIFY_EVENTS=claim,failure,captcha
# URL publique de l'interface, pour les liens de déblocage envoyés en notif
#PUBLIC_URL=https://claim.mondomaine.fr
#SLACK_WEBHOOK=
# Webhook générique : {{title}} et {{text}} sont remplacés dans le gabarit
#WEBHOOK_URL=
#WEBHOOK_METHOD=POST
#WEBHOOK_TEMPLATE={"title":"{{title}}","message":"{{text}}"}
# E-mail via ton serveur SMTP (Gmail : utilise un mot de passe d'application)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
# true = TLS direct (port 465), false = STARTTLS
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=claim-auto@mondomaine.fr
#SMTP_TO=moi@mondomaine.fr

# SMS via l'API Free Mobile (abonnés Free)
#FREEMOBILE_USER=
#FREEMOBILE_PASS=
DISCORD_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
#NTFY_SERVER=https://ntfy.sh
# Notifier même quand il n'y a rien de neuf
#NOTIFY_ON_NOTHING=false

# Ports côté hôte — à changer seulement s'ils sont déjà pris
WEB_PORT_HOST=8080
NOVNC_PORT_HOST=6080
VNC_PORT_HOST=5900

# UID/GID des fichiers écrits dans ./data (id -u / id -g)
PUID=1000
PGID=1000

# Activer automatiquement les clés Prime sur le store partenaire
#AUTO_REDEEM_KEYS=true
# E-mail pour les activations Legacy Games (pas de compte nécessaire)
LEGACY_EMAIL=

# Rafraîchissement de la liste des jeux (vide = désactivé)
#DETECT_SCHEDULE=0 */6 * * *

# Relance d une demande d intervention non levee (secondes, 0 = jamais)
#ATTENTION_REMIND=21600
